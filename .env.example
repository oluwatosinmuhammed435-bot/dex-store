# Supabase Configuration (Frontend - Safe public keys only)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Business WhatsApp line (digits only with international dial code)
VITE_WHATSAPP_NUMBER="2340000000000"

# Note: NEVER expose the SUPABASE_SERVICE_ROLE_KEY in frontend environment files.
# The service role key bypasses Row-Level Security and must only be used in secure
# server environments or Edge Functions.
